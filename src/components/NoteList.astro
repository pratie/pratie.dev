---
import { fmtDate, noteUrl, readingTime, type Note } from '../lib/notes';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
---

<ul class="entries">
  {
    notes.map((note) => (
      <li class="entry">
        <div class="entry-head">
          <a href={noteUrl(note.id)}>{note.data.title}</a>
          <span class="entry-meta">
            <time datetime={note.data.date.toISOString()}>{fmtDate(note.data.date)}</time> · {readingTime(note.body)} min
          </span>
        </div>
        <p>{note.data.description}</p>
      </li>
    ))
  }
</ul>
