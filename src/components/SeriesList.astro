---
// Each series as one entry: its name, what it is, and how long it runs.
import { SERIES } from '../data/series';
import { inSeries, noteUrl, readingTime, type Note } from '../lib/notes';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const all = Object.entries(SERIES)
  .map(([id, series]) => ({ id, ...series, chapters: inSeries(notes, id) }))
  .filter((series) => series.chapters.length > 0);
---

<ul class="entries">
  {
    all.map((series) => (
      <li class="entry">
        <div class="entry-head">
          <a href={`/${series.id}`}>{series.title}</a>
          <span class="entry-meta">
            {series.chapters.length} chapters · {series.chapters.reduce((sum, note) => sum + readingTime(note.body), 0)} min
          </span>
        </div>
        <p>{series.blurb}</p>
        <p>
          Start with <a href={noteUrl(series.chapters[0].id)}>{series.chapters[0].data.title}</a>.
        </p>
      </li>
    ))
  }
</ul>
