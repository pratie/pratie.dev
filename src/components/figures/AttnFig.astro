---
// Real attention weights from five GPT-2 heads. Pick a head, pick the token doing the reading.
import Figure from './Figure.astro';
import Tok from './Tok.astro';
import data from '../../data/gpt2/attn.json';

// What each head visibly does on this sentence. Descriptions of the data, not claims about the model at large.
const notes: Record<string, { name: string; note: string }> = {
  '9.8': {
    name: 'finds the subject',
    note: 'Parked on the start token for most of the sentence. From “in” onwards, once a place is about to be needed, it looks back at the pieces of “Eiffel Tower”.',
  },
  '4.11': {
    name: 'previous token',
    note: 'Every token looks at the one right before it and at nothing else.',
  },
  '2.9': {
    name: 'last content word',
    note: 'Glues “el” back onto “iff”, then mostly points at the most recent word that carried meaning: “Tower”, then “located”, then “city”.',
  },
  '1.10': {
    name: 'running average',
    note: 'Spreads its attention almost evenly over every earlier word, and ignores the start token.',
  },
  '5.1': {
    name: 'parked',
    note: 'All of its attention sits on the start token. On this sentence the head has nothing to add, and this is how a head says so.',
  },
};

const heads = data.heads.map((head) => {
  const id = `${head.layer}.${head.head}`;
  return { id, w: head.w, ...notes[id] };
});
const tokens = data.tokens.map((t, i) => (i === 0 ? 'start' : t));
const reader = tokens.length - 1;
---

<Figure interactive>
  <fig-attn data-heads={JSON.stringify(heads)} data-reader={reader}>
    <div class="fig-controls" role="group" aria-label="Attention head">
      {
        heads.map((head, i) => (
          <button class="btn" type="button" data-head={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            {head.id} {head.name}
          </button>
        ))
      }
    </div>

    <p class="note" data-note aria-live="polite">{heads[0].note}</p>

    <div class="sheet">
      <div class="readers" role="group" aria-label="Token doing the reading">
        {
          tokens.map((t, i) => (
            <button class:list={['reader', { start: i === 0 }]} type="button" data-i={i} aria-pressed={i === reader ? 'true' : 'false'}>
              <Tok t={t} />
              <span class="w" />
            </button>
          ))
        }
      </div>
    </div>

    <p class="fig-label" data-hint>
      The outlined token is reading. Yellow shows where it looks, and the numbers add up to 100%. Hover or tap
      another token to make it the reader.
    </p>
  </fig-attn>
  <Fragment slot="caption"><slot /></Fragment>
</Figure>

<style>
  fig-attn {
    display: block;
  }

  fig-attn > * + * {
    margin-top: 1rem;
  }

  .note {
    margin-bottom: 0;
    min-height: 4.5em;
    max-width: 36rem;
    font-family: var(--font-text);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .readers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.3rem;
  }

  .reader {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    min-width: 2.6rem;
    padding: 0.2rem 0.15rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }

  .reader :global(.tok) {
    background: color-mix(in oklab, var(--mark-ground) calc(var(--a, 0) * 100%), var(--paper));
    box-shadow: inset 0 0 0 1px var(--rule);
    transition:
      background-color 0.25s,
      box-shadow 0.2s;
  }

  .reader.start :global(.tok) {
    font-style: italic;
  }

  .reader[aria-pressed='true'] :global(.tok) {
    box-shadow:
      inset 0 0 0 1px var(--pen),
      0 0 0 1px var(--pen);
  }

  .reader.future :global(.tok) {
    color: var(--ink-2);
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--rule);
    text-decoration: line-through;
    text-decoration-color: var(--rule);
  }

  .w {
    min-height: 1.3em;
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  @media (min-width: 40rem) {
    .reader {
      min-width: 3rem;
    }

    .reader :global(.tok) {
      font-size: 0.9375rem;
    }
  }
</style>

<script>
  interface Head {
    id: string;
    name: string;
    note: string;
    w: number[][];
  }

  class FigAttn extends HTMLElement {
    heads: Head[] = [];
    head = 0;
    reader = 0;

    connectedCallback() {
      this.heads = JSON.parse(this.dataset.heads ?? '[]');
      this.reader = Number(this.dataset.reader);

      this.querySelectorAll<HTMLButtonElement>('[data-head]').forEach((button) =>
        button.addEventListener('click', () => {
          this.head = Number(button.dataset.head);
          this.draw();
        }),
      );
      this.querySelectorAll<HTMLButtonElement>('.reader').forEach((button) => {
        const pick = () => {
          this.reader = Number(button.dataset.i);
          this.draw();
        };
        button.addEventListener('click', pick);
        button.addEventListener('focus', pick);
        button.addEventListener('pointerenter', (event) => {
          if (event.pointerType === 'mouse') pick();
        });
      });
      this.draw();
    }

    draw() {
      const head = this.heads[this.head];
      const weights = head.w[this.reader];
      this.querySelectorAll('[data-head]').forEach((b, i) => b.setAttribute('aria-pressed', String(i === this.head)));
      this.querySelector('[data-note]')!.textContent = head.note;

      this.querySelectorAll<HTMLButtonElement>('.reader').forEach((button, i) => {
        const future = i > this.reader;
        const w = future ? 0 : weights[i];
        button.classList.toggle('future', future);
        button.setAttribute('aria-pressed', String(i === this.reader));
        // a gentle curve so a 20% weight is still visible; the number underneath is exact
        button.style.setProperty('--a', String(Math.pow(w, 0.6)));
        const label = button.querySelector('.w')!;
        label.textContent = future ? '' : w >= 0.995 ? '100%' : w >= 0.005 ? `${Math.round(w * 100)}%` : '·';
      });
    }
  }

  customElements.define('fig-attn', FigAttn);
</script>
