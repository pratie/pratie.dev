---
// Softmax, one step per row, on four editable scores. Includes the overflow and its fix.
import Figure from './Figure.astro';
import Tok from './Tok.astro';

const words = [' mat', ' sofa', ' roof', ' moon'];
const start = [3, 2, 1, -1];
const uid = crypto.randomUUID().slice(0, 8);
---

<Figure interactive>
  <fig-softmax data-start={JSON.stringify(start)}>
    <div class="sheet">
      <div class="steps">
        <span class="head"></span>
        {words.map((w) => <span class="word"><Tok t={w} /></span>)}

        <span class="head">score</span>
        {
          start.map((v, i) => (
            <input
              class="field-input score"
              type="number"
              step="0.5"
              value={v}
              inputmode="decimal"
              aria-label={`score for${words[i]}`}
              id={`sm-${uid}-${i}`}
              data-score
            />
          ))
        }

        <span class="head shift" data-shift-head hidden>− largest</span>
        {start.map(() => <span class="cell shift" data-shift hidden />)}

        <span class="head">e<sup>x</sup></span>
        {start.map(() => <span class="cell" data-exp />)}

        <span class="head">÷ sum</span>
        {start.map(() => <span class="cell" data-prob />)}
      </div>
      <p class="fig-label sum" data-sum></p>
    </div>

    <div class="fig-controls">
      <button class="btn" type="button" data-stable aria-pressed="false">Subtract the largest first</button>
      <button class="btn" type="button" data-big>Make one score 800</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <p class="verdict" data-verdict aria-live="polite"></p>
  </fig-softmax>
  <Fragment slot="caption"><slot /></Fragment>
</Figure>

<style>
  fig-softmax {
    display: block;
  }

  fig-softmax > * + * {
    margin-top: 1rem;
  }

  .steps {
    display: grid;
    grid-template-columns: 4.2rem repeat(4, minmax(0, 1fr));
    gap: 0.4rem 0.3rem;
    align-items: center;
  }

  @media (max-width: 34rem) {
    .steps {
      grid-template-columns: 3.4rem repeat(4, minmax(0, 1fr));
    }

    .word :global(.tok),
    .cell,
    .score {
      font-size: 0.75rem;
    }

    .word :global(.tok) {
      padding-inline: 0.15em;
    }
  }

  .head {
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.25;
  }

  .word {
    text-align: center;
  }

  .score {
    min-width: 0;
    min-height: 2.25rem;
    padding: 0.3rem 0.2rem;
    text-align: center;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .score::-webkit-outer-spin-button,
  .score::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cell {
    box-shadow: inset 0 0 0 1px var(--rule);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cell:global(.bad) {
    color: var(--warn);
    background: var(--warn-wash);
    box-shadow: inset 0 0 0 1px var(--warn);
    font-weight: 700;
  }

  [hidden] {
    display: none;
  }

  .sum {
    margin-top: 0.75rem;
  }

  .verdict {
    margin-bottom: 0;
    min-height: 3.1em;
    max-width: 36rem;
    font-family: var(--font-text);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>

<script>
  import { num } from '../../lib/fig';

  /** Short text for a number that may be huge, infinite or not a number. */
  const show = (x: number) => {
    if (!Number.isFinite(x)) return num(x);
    if (x !== 0 && (Math.abs(x) >= 1e5 || Math.abs(x) < 1e-3)) return x.toExponential(1).replace('e+', 'e').replace('-', '−');
    return num(x, 2);
  };

  class FigSoftmax extends HTMLElement {
    stable = false;

    connectedCallback() {
      const start: number[] = JSON.parse(this.dataset.start ?? '[]');
      const inputs = this.all<HTMLInputElement>('score');
      inputs.forEach((input) => input.addEventListener('input', () => this.draw()));

      const stableButton = this.querySelector<HTMLButtonElement>('[data-stable]')!;
      stableButton.addEventListener('click', () => {
        this.stable = !this.stable;
        stableButton.setAttribute('aria-pressed', String(this.stable));
        this.draw();
      });
      this.querySelector('[data-big]')!.addEventListener('click', () => {
        inputs[1].value = '800';
        this.draw();
      });
      this.querySelector('[data-reset]')!.addEventListener('click', () => {
        inputs.forEach((input, i) => (input.value = String(start[i])));
        this.draw();
      });
      this.draw();
    }

    all<T extends HTMLElement = HTMLElement>(name: string) {
      return [...this.querySelectorAll<T>(`[data-${name}]`)];
    }

    draw() {
      const scores = this.all<HTMLInputElement>('score').map((input) => Number(input.value) || 0);
      const largest = Math.max(...scores);
      const used = this.stable ? scores.map((s) => s - largest) : scores;
      const exps = used.map(Math.exp);
      const sum = exps.reduce((a, b) => a + b, 0);
      const probs = exps.map((e) => e / sum);

      this.querySelector<HTMLElement>('[data-shift-head]')!.hidden = !this.stable;
      this.all('shift').forEach((cell, i) => {
        cell.hidden = !this.stable;
        cell.textContent = show(used[i]);
      });
      this.all('exp').forEach((cell, i) => {
        cell.textContent = show(exps[i]);
        cell.classList.toggle('bad', !Number.isFinite(exps[i]));
        cell.style.setProperty('--heat', '0');
      });
      this.all('prob').forEach((cell, i) => {
        const broken = Number.isNaN(probs[i]);
        cell.textContent = broken ? 'NaN' : num(probs[i], 3);
        cell.classList.toggle('bad', broken);
        cell.style.setProperty('--heat', broken ? '0' : String(probs[i]));
      });

      this.querySelector('[data-sum]')!.textContent = `Sum of the e^x row: ${show(sum)}`;

      const verdict = this.querySelector('[data-verdict]')!;
      if (probs.some(Number.isNaN)) {
        verdict.textContent =
          'Broken. e^800 is bigger than the largest number a 64-bit float can hold, about 1.8 × 10^308, so it is stored as ∞. Then ∞ ÷ ∞ has no answer, and you get NaN. NumPy does exactly the same.';
      } else if (this.stable) {
        verdict.textContent =
          'The answer the formula promises. The largest exponent is now e^0 = 1, so nothing can overflow however big the scores get.';
      } else {
        verdict.textContent = 'The bottom row always adds up to 1. Raise one score and it takes probability from all the others.';
      }
    }
  }

  customElements.define('fig-softmax', FigSoftmax);
</script>
