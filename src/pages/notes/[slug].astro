---
import NotePage from '../../components/NotePage.astro';
import { allNotes, standalone, type Note } from '../../lib/notes';

export async function getStaticPaths() {
  return standalone(await allNotes()).map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: Note;
}

const { note } = Astro.props;
---

<NotePage note={note} />
